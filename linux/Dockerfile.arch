# The toolchain that checks fuji's PKGBUILD.
#
# This one produces nothing anybody downloads, which is the point worth understanding about the AUR. A PKGBUILD is a recipe, not a package: it lives in a git repository Arch hosts, and an Arch user's own machine follows it. So there is no binary for this pipeline to make — what a container can do is prove the recipe works, by running makepkg against it exactly as a user's machine would.
#
# Arch publishes x86_64 images only, so this one runs emulated on apple silicon. It is a short build, so that costs little.
FROM --platform=linux/amd64 archlinux:base-devel

# pacman 7 sandboxes its own downloads with seccomp and landlock, and inside a container — more so inside an emulated one — that sandbox cannot start: "error restricting syscalls via seccomp: 22". Turning it off in pacman.conf rather than passing a flag matters, because makepkg calls pacman again later for --syncdeps and would hit the same wall with nowhere to pass the flag.
RUN sed -i 's/^\[options\]/[options]\nDisableSandbox/' /etc/pacman.conf

# base-devel already carries makepkg, binutils and fakeroot. The update is so the dependency names in the PKGBUILD are checked against a current package database rather than whatever the image froze.
RUN pacman -Syu --noconfirm && rm -rf /var/cache/pacman/pkg/*

# makepkg refuses to run as root, by design and without an override worth using. So the image carries a user for it, with passwordless sudo because makepkg wants to install build dependencies.
RUN useradd --create-home --shell /bin/bash builder \
 && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder

# No script is baked in. What a container does is mounted at run time by build.js, because an image here is the toolchain and nothing else — editing a build step should not mean rebuilding one.
