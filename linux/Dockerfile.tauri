# The toolchain that turns fuji's source into a .deb and an .rpm. Built twice, once per architecture, from this one file — amd64 runs emulated on an apple silicon mac and arm64 runs native.
#
# Debian 12 is the base for one reason: glibc. A binary is compatible with its build machine's glibc and every later one, never an earlier one, so the base sets a floor on who can run the result. Debian 12's 2.36 reaches Debian 12 and 13, Ubuntu 24.04 LTS and 26.04, Mint 22.x, Fedora 40 and up, and both the bookworm and trixie generations of Raspberry Pi OS. Debian 13 would have moved the floor to 2.41 and shut out the current Ubuntu LTS. Reaching back costs nothing at the newer end, which is why the rule is to build on the oldest base that still carries the libraries, not the newest.
#
# This image holds no source and no secrets. It is the durable half of the pipeline — rebuilt when a version below changes and not otherwise — while a container made from it lives for exactly one build.
FROM debian:12-slim

# Tauri's own linux prerequisites, plus three of ours. rpm carries rpmbuild, which the rpm bundler shells out to and which a debian machine has no other reason to own. xz-utils unpacks the node tarball below. ca-certificates is what lets curl reach nodejs.org and sh.rustup.rs at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file git pkg-config ca-certificates \
      libwebkit2gtk-4.1-dev librsvg2-dev libssl-dev libxdo-dev libayatana-appindicator3-dev \
      rpm xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Node from nodejs.org rather than from debian, which ships 18 where the repository wants 22. The version matches .node-version at the repository root. corepack then supplies pnpm — the exact version named in the root package.json, fetched on first use, so this image never pins a pnpm of its own that could disagree with what the mac and windows box run.
ARG NODE_VERSION=22.21.0
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "no node build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
        --exclude CHANGELOG.md --exclude LICENSE --exclude README.md; \
    rm /tmp/node.tar.xz; \
    corepack enable; \
    node --version

# Rust, pinned to the same version desktop/src-tauri/rust-toolchain.toml names. Installing it here rather than letting rustup fetch it per build keeps the download in the durable layer; the toolchain file still governs, so if the two ever disagree the build slows down rather than compiling wrong.
ARG RUST_VERSION=1.98.0
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" \
 && rustc --version && cargo --version

# No script is baked in. What a container does is mounted at run time by build.js, because an image here is the toolchain and nothing else — editing a build step should not mean rebuilding one.
