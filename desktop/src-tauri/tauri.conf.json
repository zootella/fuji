{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Fuji",
	"version": "0.1.0",
	"identifier": "com.zootella.fuji",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite-build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Fuji",
				"width": 800,
				"height": 600,
				"visible": false,
				"dragDropEnabled": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis", "deb"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/mac/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"icons/tile/fuji.VisualElementsManifest.xml": "fuji.VisualElementsManifest.xml",
			"icons/tile/tile-medium.png": "tile-medium.png",
			"icons/tile/tile-small.png": "tile-small.png"
		}
	}
}
