{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Fuji",
	"version": "0.1.0",
	"identifier": "app.fujidesktop.Fuji",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite-build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg", "nsis", "deb"],
		"publisher": "Fuji",
		"homepage": "https://fujidesktop.app/",
		"copyright": "Copyright © 2026 Fuji",
		"license": "GPL-3.0-only",
		"licenseFile": "../../LICENSE",
		"shortDescription": "A multimedia file manager designed with privacy and precision in mind",
		"longDescription": "A multimedia file manager designed with privacy and precision in mind",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/mac/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {"desktopTemplate": "fuji.desktop.hbs"},
			"rpm": {"desktopTemplate": "fuji.desktop.hbs"}
		},
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		},
		"resources": {
			"icons/tile/fuji.VisualElementsManifest.xml": "fuji.VisualElementsManifest.xml",
			"icons/tile/tile-medium.png": "tile-medium.png",
			"icons/tile/tile-small.png": "tile-small.png",
			"icons/document/document-sheet.ico": "document-sheet.ico",
			"icons/document/document-image.ico": "document-image.ico",
			"icons/document/document-video.ico": "document-video.ico"
		}
	}
}
