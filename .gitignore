# dependencies and build output, both sides of the app; one file at the root covers vite and cargo together
node_modules
dist
/src-tauri/target/
/src-tauri/gen/schemas

# logs and diffs
logs
*.log
*.diff
diff*.txt

# environment files, kept because these are the patterns that would otherwise commit a secret one day; vite reads .env and .env.<mode>, and tauri's signing and notarization credentials are environment variables
.env
.env.*
*.local

# editors and agents
.vscode/*
!.vscode/extensions.json
.idea
.fleet
.claude/RESUME.md
.claude/settings.local.json

# os junk, mac and windows
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.stackdump

# private planning and notes; "hide" as a dot-separated part of a file or folder name stays out of the public repo
hide
hide.*
*.hide
*.hide.*

# tauri icon writes a whole tree for the macos source; only the icns it makes is kept, in icons/mac
src-tauri/icons/.mac
